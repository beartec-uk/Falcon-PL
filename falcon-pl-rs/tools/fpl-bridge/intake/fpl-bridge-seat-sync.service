# Co-signer operator seats. Env: FPL_SEAT_ID, FPL_LEAD_SEAT_URL (lead tailnet IP:8791), FPL_OP_HOME.
[Unit]
Description=Falcon PL testnet4 bridge seat sync (co-signer operator)
After=network-online.target fpl-operatord.service
[Service]
EnvironmentFile=/opt/fpl-operator/seat-sync.env
ExecStart=/usr/bin/python3 /opt/fpl-operator/bin/seat_sync.py
Restart=always
RestartSec=5
User=root
MemoryMax=6G
# KillMode=process: restarting seat_sync does not kill an in-flight participant (its
# RAM-only key would be lost and the ceremony would fail). The new seat_sync adopts it
# via /proc (no second participant) and stops it when the lead drops the request.
KillMode=process
[Install]
WantedBy=multi-user.target
