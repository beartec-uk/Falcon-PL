# Dynamic keys (re-read not yet; PAUSE file works immediately).
# Stop new legs:  touch /home/falcon/loadgen/bridge/PAUSE
# or LOADGEN_PAUSE=1 and restart the *bridge* unit only (not validators).
LOADGEN_PAUSE=0
TEST_ID=FPL-BTC4-BRIDGE-LOAD-2026-11-13
BRIDGE_HOME=/home/falcon/loadgen/bridge
BRIDGE_RECORD_DIR=/home/falcon/loadgen/bridge/record
PAUSE_FILE=/home/falcon/loadgen/bridge/PAUSE
LOADGEN_KEYS=<path>
LOADGEN_FAUCET_KEYS=<path>
LOADGEN_FAUCET_ACCOUNT=faucet
LOADGEN_PREFIX=loadtest
LOADGEN_WALLETS=4
FPL_FUND_AMOUNT=10000
FPL_FLOOR=2000
PEGIN_SATS=55000
PEG_IN_FEE=590
LEG_TIMEOUT_SECS=21600
MAX_UNFINALIZED_CLAIMS=4
MAX_SPEND_SATS_PER_DAY=2000000
HEADERS_FPL_FLOOR=200
BATCH_GAP_SECS=21600
BATCH_WINDOW_SECS=3600
BATCH_SIZE_A=10
BATCH_SIZE_B=20
RAIL_SYNC_MAX_LAG=2
# peg-in pacing (one BitVM2 ceremony at a time) and stall alerts
MAX_CONCURRENT_PEGIN_CEREMONIES=1
PEGIN_GATE_POLL_SECS=20
PEGIN_GATE_WAIT_SECS=3600
PEGIN_STALL_ALERT_SECS=1800
BATCH_JITTER_FRAC=0.25
ONCE_ACCOUNT=loadtest01
FPL_CTL=/var/lib/falcon-pl-2300/bin/falcon-pl-ctl
FPL_RPC=127.0.0.1:19301
INTAKE=http://127.0.0.1:8790
SIGN_MJS=/home/falcon/loadgen/bridge/sign.mjs
BTC_WALLET=fpl-operator
BITCOIN_CLI=/opt/fpl-tn4btc/bin/bitcoin-cli
BITCOIN_CONF=/opt/fpl-tn4btc/bitcoin.conf
BITCOIN_DATADIR=/opt/fpl-tn4btc/data
ESPLORA=https://mempool.space/testnet4/api
# DISCORD_HEALTH_WEBHOOK_URL is loaded from a 0600 sidecar if present; do not put the URL here.
